# ─────────────────────────────────────────────────────────────
#  Mendez Brothes website — environment
#  Local dev: copy to .env (defaults below work with the dev DB).
#  Production: copy to .env on the server and change EVERY secret.
# ─────────────────────────────────────────────────────────────

# Public URL of the site, no trailing slash (baked into the build).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production only (docker-compose.yml): domain served by Caddy, e.g. mendezbrothes.com
SITE_DOMAIN=example.com

# Database. In production docker-compose builds DATABASE_URL from these.
POSTGRES_USER=mendez
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=mendez
# Local dev only (docker run postgres on port 5440 — see README):
DATABASE_URL=postgres://mendez:mendez@127.0.0.1:5440/mendez

# Secrets — generate with:  openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Used for draft preview links
PREVIEW_SECRET=change-me
# Protects /next/revalidate and scheduled jobs (16+ characters)
CRON_SECRET=change-me-at-least-16-chars

# Email for form notifications (optional; without it emails are only logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME="Mendez Brothes Website"

# First admin account created by the seed script on an empty database.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# No domain yet? Serve plain HTTP on the server's IP: uncomment the next line, and set
# NEXT_PUBLIC_SERVER_URL=http://<ip> and SITE_DOMAIN=<ip>.
# CADDYFILE=./deploy/Caddyfile.ip

# Site on a subdomain (no www.<domain> record)? Use the variant without the www redirect:
# CADDYFILE=./deploy/Caddyfile.nowww
