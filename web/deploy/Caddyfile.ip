# Used while the site has no domain yet: plain HTTP on the server's IP address.
# Select it with CADDYFILE=./deploy/Caddyfile.ip in .env. Once a domain points at the
# server, remove that line, set SITE_DOMAIN + NEXT_PUBLIC_SERVER_URL and redeploy —
# the default Caddyfile then gets an HTTPS certificate automatically.

:80 {
	encode zstd gzip

	# Static build assets and fonts never change for a given URL.
	@immutable path /_next/static/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header -Server

	@backupUpload path /api/backups/upload
	request_body @backupUpload {
		max_size 5GB
	}
	@otherRequests not path /api/backups/upload
	request_body @otherRequests {
		max_size 50MB
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
